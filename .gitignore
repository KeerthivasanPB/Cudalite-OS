# Ignore compiled binaries
application/hello_cuda
application/cudalite-benchmark

# Ignore live-build generated chroot, caches, and ISOs (keep config/)
build/live/binary*
build/live/cache/
build/live/chroot*
build/live/*.iso
build/live/*.packages
build/live/*.files
build/live/*.zsync
build/live/live-image*
build/live/.build/
*.log

# Binaries staged into the image by scripts/build_benchmark.sh (regenerated, never committed)
build/live/config/includes.chroot/usr/local/bin/cudalite-benchmark
build/live/config/includes.chroot/usr/local/bin/hello_cuda

# kernel build environment and sources (regenerated by scripts/build_kernel.sh)
build/kernel/

# custom kernel packages (regenerated by scripts/build_kernel.sh)
build/live/config/packages.chroot/*.deb
__pycache__/
