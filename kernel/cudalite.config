# Applied on top of Debian's config after localmodconfig (scripts/config syntax: SYMBOL=value / SYMBOL=n).
# Identity
LOCALVERSION="-cudalite"
LOCALVERSION_AUTO=n
# No Debian signing certificates in this tree. MODULE_SIG stays on (selected by other options), so in-tree
# modules are signed with a throwaway build key; MODULE_SIG_FORCE stays off, so the unsigned NVIDIA DKMS
# module still loads (kernel tainted, Secure Boot off - documented).
SYSTEM_TRUSTED_KEYS=""
SYSTEM_REVOCATION_KEYS=""
# No debug info: faster build, smaller packages (the image never debugs the kernel)
DEBUG_INFO_NONE=y
DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
DEBUG_INFO_DWARF5=n
DEBUG_INFO_BTF=n
# Required by CudaLite even if no module was loaded at capture time
SQUASHFS=m
SQUASHFS_XZ=y
OVERLAY_FS=m
BLK_DEV_LOOP=m
ISO9660_FS=m
VFAT_FS=m
