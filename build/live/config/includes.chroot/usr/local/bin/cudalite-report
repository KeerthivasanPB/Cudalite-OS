#!/bin/bash
# cudalite-report: collect every validation output for the CudaLite OS report in one go.
# Run on the booted image:   cudalite-report            (quick benchmark)
#                            cudalite-report --full     (also run the full benchmark)
# Output: printed and saved to ~/cudalite-validation-<time>.txt, and copied automatically to the
# USB stick's RESULTS partition when present (made by scripts/make_usb.sh).
export PATH="$PATH:/usr/sbin:/sbin"   # sysctl, modinfo, ... are not on a normal user's PATH
OUT="${HOME}/cudalite-validation-$(date +%Y%m%dT%H%M%S).txt"
FULL=0; [ "${1:-}" = "--full" ] && FULL=1

sec() { printf '\n==================== %s ====================\n' "$*"; }
run() { printf '\n$ %s\n' "$*"; bash -c "$*" 2>&1; }

{
sec "1. System and kernel"
run "uname -a"
run "cat /etc/os-release | head -4"
run "cat /proc/cmdline"

sec "2. GPU and driver"
run "lspci -nnk | grep -A3 -i nvidia"
run "lsmod | grep -i nvidia"
run "nvidia-smi"
run "nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used,utilization.gpu,power.draw --format=csv"
run "ls -l /dev/nvidia*"
run "dpkg-query -W nvidia-kernel-dkms libcuda1 nvidia-smi firmware-nvidia-gsp"

sec "3. Auto-start service"
run "systemctl status cudalite-benchmark.service --no-pager"
run "sudo journalctl -u cudalite-benchmark.service -b --no-pager"
run "systemctl show cudalite-benchmark.service -p ActiveEnterTimestampMonotonic -p Result -p ExecMainStatus"

sec "4. CUDA smoke test and benchmark"
run "/usr/local/bin/hello_cuda"
run "/usr/local/bin/cudalite-benchmark --quick"
[ "$FULL" = 1 ] && run "/usr/local/bin/cudalite-benchmark --full --out $HOME/bench"

sec "5. Boot time"
run "systemd-analyze"
run "systemd-analyze critical-chain --no-pager"
run "systemd-analyze blame --no-pager | head -15"

sec "6. Memory and footprint"
run "free -h"
run "grep -E 'MemTotal|MemFree|MemAvailable|Shmem:' /proc/meminfo"
run "echo installed packages: \$(dpkg-query -W -f='\${binary:Package}\\n' | sort -u | wc -l)"
run "ls -l /run/live/medium/live/ 2>/dev/null"
run "df -h / /run/live/medium 2>/dev/null"
run "sudo du -s --block-size=1M /run/live/rootfs/filesystem.squashfs /run/live/rootfs/filesystem.squashfs/{usr,var,etc} 2>/dev/null"   # image content (read-only layer); du -x reports 0 on the overlay

sec "7. Hardening verification"
run "findmnt -o TARGET,SOURCE,FSTYPE,OPTIONS -t overlay,squashfs,iso9660"
run "id cudalite"
run "ss -tulpn"
run "sudo nft list ruleset"
run "systemd-analyze security cudalite-benchmark.service --no-pager | tail -25"
run "sysctl kernel.kptr_restrict kernel.dmesg_restrict kernel.yama.ptrace_scope kernel.unprivileged_bpf_disabled"
run "sudo touch /run/live/rootfs/filesystem.squashfs/rw-test 2>&1; echo '^ squashfs base layer is read-only even for root'"
run "sudo touch /rw-test && echo 'write to / as root succeeded: it lands in the RAM overlay (lost at reboot)' && sudo rm /rw-test"
run "sudo dmesg | grep -iE 'nvidia|nvrm|firmware' | head -25"
} 2>&1 | tee "$OUT"

echo
echo "Saved to $OUT"

# Copy to the USB stick's RESULTS partition if it is plugged in (FAT32 is root-owned here, hence sudo).
RES=/dev/disk/by-label/RESULTS
if [ -e "$RES" ]; then
    MNT="$(mktemp -d)"
    if sudo mount "$RES" "$MNT"; then
        sudo cp "$OUT" "$MNT"/
        [ -d "$HOME/bench" ] && sudo cp -r "$HOME/bench" "$MNT"/
        sync
        sudo umount "$MNT" && echo "Copied to the USB stick's RESULTS partition: $(basename "$OUT")$([ -d "$HOME/bench" ] && echo ' and bench/')"
    else
        echo "Could not mount the RESULTS partition; copy $OUT manually with sudo cp."
    fi
    rmdir "$MNT"
else
    echo "No RESULTS partition found; results are only in RAM until you copy them (use sudo cp)."
fi
